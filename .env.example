# ---------------------------------------------------------------- database
# Local development: a plain Postgres instance.
# Production: the Supabase connection pooler URI
# (Supabase dashboard → Project Settings → Database → Connection pooling).
DATABASE_URL=postgresql://app:app@127.0.0.1:5432/untitled
DATABASE_POOL_MAX=10

# ------------------------------------------------------------------ secrets
# Random strings. Generate with: openssl rand -base64 32
AUTH_SECRET=
CLICK_HASH_SECRET=

# ------------------------------------------------------------------ supabase
# Auth and Storage. The service role key is server-only and must never be
# exposed to the browser or committed.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=link-images

# -------------------------------------------------------------------- stripe
# Test mode during development. The webhook secret comes from
# `stripe listen --forward-to localhost:3000/api/stripe/webhook`.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------- site
# Unset in production, the app uses https://topmart.live (src/config/site.ts).
# Set this only to override — e.g. locally, or on a temporary deploy URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Protects the scheduled endpoints (/api/cron/*) from public invocation.
CRON_SECRET=

# Development only. Skips the email OTP challenge so the authenticated flows can
# be exercised without a mail provider. Never enable this in production.
AUTH_DEV_MODE=false
